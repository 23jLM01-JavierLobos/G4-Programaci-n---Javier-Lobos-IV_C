Algoritmo Lecc24_Act3_In2
	Definir numero, i, suma Como Entero
	
    Escribir "Ingrese un numero entero:"
    Leer numero
	
    suma = 0
	
    Para i = numero Hasta 1 Con Paso -1 Hacer
        Escribir i
        suma = suma + i
    FinPara
	
    Escribir "La suma total es: ", suma

	
FinAlgoritmo

Algoritmo Lecc23_Act4_In1
		
		Definir numero, i Como Entero
		
		i = 1
		
		Escribir "Ingrese un número: "
		Leer numero
		
		Escribir "Tabla de multiplicar del ", numero
		
		Mientras i <= 10 Hacer
			Escribir numero, " x ", i, " = ", numero * i
			i = i + 1
		FinMientras
		
FinAlgoritmo


